# Copier ce fichier en .env et remplacer les valeurs.
# Le fichier .env n'est jamais commité (voir .gitignore).

# Base MongoDB locale (mongod sur le port 27017)
DATABASE_URL=mongodb://127.0.0.1:27017/archioweb_ciinma

# Secret local pour signer les JWT. Générer avec :
# openssl rand -hex 32
JWT_SECRET=remplacer_par_un_secret_local

PORT=3000